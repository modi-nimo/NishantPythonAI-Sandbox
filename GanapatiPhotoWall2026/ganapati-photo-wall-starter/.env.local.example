# Google service account credentials for reading society photos.
# Do not put these values in client-side code.
# GOOGLE_DRIVE_FOLDER_ID should be the folder ID that contains uploaded photos.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Optional: Google Form response Sheet for showing "caption - person" labels.
# Share this Sheet with the same service account as Viewer.
GOOGLE_FORM_RESPONSES_SHEET_ID=
GOOGLE_FORM_RESPONSES_SHEET_RANGE="Form Responses 1"
